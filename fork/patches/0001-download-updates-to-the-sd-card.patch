+def cache_dir(need):
+    """Where to download: the mounted drive (SD card) with the most room, else internal storage."""
+    best, room = None, need + need // 4 + (1 << 30)
+    for d in glob.glob("/run/media/*/*/"):
+        try:
+            sv = os.statvfs(d)
+        except OSError:
+            continue
+        free = sv.f_bavail * sv.f_frsize
+        if os.path.ismount(d) and not sv.f_flag & os.ST_RDONLY and free >= room and (best is None or free > best[0]):
+            best = (free, d)
+    return Path(best[1]) / ".steamos-arm-update" if best else CACHE
+
+
