+/// The PMIC haptic motor plays a rumble effect as a rough buzz. A flat
+/// constant effect feels much cleaner, so rumble is converted to one: the
+/// stronger motor magnitude sets the level, with a floor so weak rumble is felt.
+const HAPTICS_NAME: &str = "qcom-hv-haptics";
+const HAPTICS_FLOOR: i32 = 6000;
+const HAPTICS_CEIL: i32 = 24000;
+
+fn haptics_effect(effect: FFEffectData) -> FFEffectData {
+    let FFEffectKind::Rumble {
+        strong_magnitude,
+        weak_magnitude,
+    } = effect.kind
+    else {
+        return effect;
+    };
+    let mag = strong_magnitude.max(weak_magnitude) as i32;
+    let level = if mag == 0 {
+        0
+    } else {
+        HAPTICS_FLOOR + mag * (HAPTICS_CEIL - HAPTICS_FLOOR) / 65535
+    };
+    FFEffectData {
+        kind: FFEffectKind::Constant {
+            level: level as i16,
+            envelope: FFEnvelope {
+                attack_length: 0,
+                attack_level: 0,
+                fade_length: 0,
+                fade_level: 0,
+            },
+        },
+        ..effect
+    }
+}
+
