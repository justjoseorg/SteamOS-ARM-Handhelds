# OpenABL bundled on every image's BOOT drive (openabl/), the bootloader
# menu ROCKNIX ABL became (same developers, ROCKNIX ships it since 2026-10-14).
# GPL-3.0 and others, (c) Open Handheld Collective,
# https://github.com/OpenHandheldCollective/OpenABL
# The release is fetched at build time and checked against these hashes;
# the binaries are never kept in this repo. The tarball hash is the one
# ROCKNIX pins in packages/tools/openabl/package.mk.
ABL_VERSION=1.0
ABL_URL=https://github.com/OpenHandheldCollective/OpenABL/releases/download/v1.0/openabl-v1.0.tar.gz
ABL_TARBALL_SHA256=d4554e26d890dfdbd2ed6e5d617d470ce902a95ade5daf2fefa86063f84b750f
ABL_SHA256_SM8250=5180c7666ffb48be0d3c004e561a60d0ae3d6cecbbafc06ef25bc1a2ff30f5e2
# SM8550: the release's own .sha256 (5bdb6cad...) is stale; the tarball and
# the standalone release asset are both this one.
ABL_SHA256_SM8550=f998fd78d9a34a311f70b26c6da82ab9f72d12db5ae9b7ab283026025370a585
ABL_SHA256_SM8650=23046d198dddaab53d7afc17bd726de4d2c65b6eb24d984a6b72e9a0963ba32c
ABL_SHA256_SM8750=1fabcab6b87f0d8e69ba45c30b14661f7715be82679da95dfdbdcbec1798ee48
